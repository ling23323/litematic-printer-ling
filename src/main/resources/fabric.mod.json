{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "icon": "assets/litematic-printer-ling/icon.png",
  "name": "${mod_name}",
  "description": "An extension for Litematica that adds the missing printer functionality.",
  "authors": [
    "aleksilassila",
    "zhaixianyu",
    "BlinkWhite",
    "bunnyi116"
  ],
  "contributors": [
    "Ling"
  ],
  "contact": {
    "website": "${mod_homepage}",
    "homepage": "${mod_sources}",
    "sources": "${mod_sources}"
  },
  "license": "${mod_license}",
  "environment": "client",
  "entrypoints": {
    "main": [
      "ling.printer.LitematicaPrinterMod"
    ],
    "client": [
      "ling.printer.LitematicaPrinterMod"
    ],
    "modmenu": [
      "ling.printer.config.ModMenu"
    ]
  },
  "mixins": [
    "litematic-printer-ling.core.mixins.json",
    "litematic-printer-ling.litematica.mixins.json",
    "litematic-printer-ling.malilib.mixins.json",
    "litematic-printer-ling.optional.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_dependency}",
    "malilib": ">=${malilib}",
    "litematica": ">=${litematica}",
    "fabric-api": "*",
    "fabric-content-registries-v0": "*"
  },
  "custom": {
    "modmenu": {
      "parent": "${mod_wrapper_id}"
    }
  }
}

