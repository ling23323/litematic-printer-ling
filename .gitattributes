# 默认按文本处理，检出时统一换行；二进制后缀单独声明
* text=auto

# 源码与配置统一 LF
*.bat text eol=crlf
*.groovy text eol=lf
*.java text eol=lf
*.json text eol=lf
*.kts text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.scala text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gradle text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
build.gradle text eol=lf
gradlew text eol=lf
gradle/wrapper/gradle-wrapper.properties text eol=crlf
COPYING.txt text eol=lf
COPYING.LESSER.txt text eol=lf
README.md text eol=lf

# 二进制
*.dat binary
*.bin binary
*.png binary
*.jpg binary
*.exe binary
*.dll binary
*.zip binary
*.jar binary
*.7z binary
*.db binary
